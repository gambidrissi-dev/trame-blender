#!/bin/zsh
# Publie une version de Trame : ./publier 0.2.0
# Fabrique le zip Mac (puces Apple), commite la version, pose le tag et crée la release GitHub.
set -euo pipefail

V=${1:?Usage : ./publier x.y.z}
[[ $V =~ '^[0-9]+\.[0-9]+\.[0-9]+$' ]] || { echo "Version attendue au format x.y.z"; exit 1; }
cd "${0:A:h}"
[[ -z $(git status --porcelain) ]] || { echo "Le dépôt a des modifs non commitées : commite d'abord."; exit 1; }
git rev-parse -q --verify "refs/tags/v$V" >/dev/null && { echo "v$V existe déjà."; exit 1; }

BLENDER_PY=/Applications/Blender.app/Contents/Resources/5.2/python/bin/python3.13
ZIP=src/trame/dist/trame_py313-$V-macos-arm64.zip

# Tests avant publication (code du dépôt, via le mode développement de Blender).
B=/Applications/Blender.app/Contents/MacOS/Blender
$B -b --python src/trame/scripts/precheck.py 2>&1 | grep -q "PRECHECK OK" || { echo "Vérification préalable en échec"; exit 1; }
$B -b --python src/trame/scripts/test_trame_outils.py 2>&1 | grep -q "TEST OUTILS OK" || { echo "Tests des outils en échec"; exit 1; }
$B -b --python src/trame/scripts/test_trame_maison.py 2>&1 | grep -q "TEST MAISON OK" || { echo "Test maison R+1 en échec"; exit 1; }
$B -b --python src/trame/scripts/test_trame_assistant.py 2>&1 | grep -q "TEST ASSISTANT OK" || { echo "Test assistant en échec"; exit 1; }

echo $V > src/trame/VERSION
rm -rf src/trame/build src/trame/dist
# Ne rien modifier dans le dépôt pendant la fabrication : on compile les fichiers du disque.
( cd src/trame && SSL_CERT_FILE=/etc/ssl/cert.pem make dist PLATFORM=macosm1 PYVERSION=py313 IS_STABLE=TRUE PYTHON=$BLENDER_PY ) > build.log 2>&1 \
  || { git checkout -- src/trame/VERSION; echo "Échec de fabrication, voir build.log"; tail -20 build.log; exit 1; }
[[ -f $ZIP ]] || { echo "Zip introuvable : $ZIP"; exit 1; }
unzip -p $ZIP trame/blender_manifest.toml | grep -q "^version = \"$V\"" || { echo "Le zip ne porte pas la version $V"; exit 1; }

git diff --quiet src/trame/VERSION || git commit -qm "Trame $V" src/trame/VERSION
git tag v$V
git push -q origin main v$V
gh release create v$V $ZIP --title "Trame $V" --notes "Installation : Blender 5.2 › Préférences › Extensions › Installer depuis le disque › ce zip (Mac, puces Apple)."
echo "Trame $V publiée."
